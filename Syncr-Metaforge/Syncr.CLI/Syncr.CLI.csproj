<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Syncr.CLI</AssemblyName>
    <RootNamespace>Syncr.CLI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>SYNCR Headless CLI - Growatt PV Monitoring for Raspberry Pi Terminal</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncr.Core\Syncr.Core.csproj" />
  </ItemGroup>

</Project>
