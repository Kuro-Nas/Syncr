<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Syncr.UI.App"
             RequestedThemeVariant="Dark">

    <!-- Performance: Force hardware acceleration -->
    <Application.Resources>
        <ResourceDictionary>
            <x:Double x:Key="DesiredFrameRate">60</x:Double>
            <SolidColorBrush x:Key="AccentPrimary">#06B6D4</SolidColorBrush>    <!-- Cyan 500 -->
            <SolidColorBrush x:Key="AccentSecondary">#38BDF8</SolidColorBrush>  <!-- Sky 400 -->
            <SolidColorBrush x:Key="Success">#22C55E</SolidColorBrush>          <!-- Green 500 -->
            <SolidColorBrush x:Key="Warning">#EAB308</SolidColorBrush>          <!-- Yellow 500 -->
            <SolidColorBrush x:Key="Error">#EF4444</SolidColorBrush>            <!-- Red 500 -->

            <ResourceDictionary.ThemeDictionaries>
                <!-- ── DARK THEME ──────────────────────────────────────────────────────── -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BackgroundDark">#0F172A</SolidColorBrush>   <!-- Slate 900 -->
                    <SolidColorBrush x:Key="SidebarBackground">#141E2D</SolidColorBrush><!-- Slightly deeper slate panel -->
                    <SolidColorBrush x:Key="SurfaceDark">#1E293B</SolidColorBrush>      <!-- Slate 800 (cards) -->
                    <SolidColorBrush x:Key="SurfaceElevated">#283548</SolidColorBrush>  <!-- Slate 750 (active cards) -->
                    <SolidColorBrush x:Key="SurfaceLight">#334155</SolidColorBrush>     <!-- Slate 700 (borders) -->
                    <SolidColorBrush x:Key="TextPrimary">#F1F5F9</SolidColorBrush>      <!-- Slate 100 -->
                    <SolidColorBrush x:Key="TextSecondary">#94A3B8</SolidColorBrush>    <!-- Slate 400 -->
                    <SolidColorBrush x:Key="AccentAction">#38BDF8</SolidColorBrush>     <!-- Sky Blue -->
                    <SolidColorBrush x:Key="StatusOk">#22C55E</SolidColorBrush>         <!-- Emerald Green -->
                    <SolidColorBrush x:Key="ButtonBackground">#283548</SolidColorBrush> <!-- Action button bg -->
                    <SolidColorBrush x:Key="ButtonBorder">#334155</SolidColorBrush>     <!-- Button border -->
                    <SolidColorBrush x:Key="ButtonHover">#2E3F58</SolidColorBrush>      <!-- Button hover -->
                </ResourceDictionary>

                <!-- ── LIGHT THEME (Warm Sand & Cream v3 Palette) ─────────────── -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BackgroundDark">#E2D5B8</SolidColorBrush>   <!-- Main window bg: #E2D5B8 as requested -->
                    <SolidColorBrush x:Key="SidebarBackground">#E2D5B8</SolidColorBrush><!-- Sidebar: Matches main bg #E2D5B8 -->
                    <SolidColorBrush x:Key="SurfaceDark">#F5ECE0</SolidColorBrush>      <!-- Cards: Warm cream parchment (floats over bg) -->
                    <SolidColorBrush x:Key="SurfaceElevated">#FAF4EA</SolidColorBrush>  <!-- Active/elevated card: Brightest warm cream -->
                    <SolidColorBrush x:Key="SurfaceLight">#C4AE80</SolidColorBrush>     <!-- Borders: Rich tan, crisp separation -->
                    <SolidColorBrush x:Key="TextPrimary">#241D16</SolidColorBrush>      <!-- Deep warm espresso text -->
                    <SolidColorBrush x:Key="TextSecondary">#6B5D45</SolidColorBrush>    <!-- Deep taupe secondary text -->
                    <SolidColorBrush x:Key="AccentAction">#A66B38</SolidColorBrush>     <!-- Burnt amber accent -->
                    <SolidColorBrush x:Key="StatusOk">#556347</SolidColorBrush>         <!-- Muted olive status ok -->
                    <!-- Buttons: Medium warm tan -->
                    <SolidColorBrush x:Key="ButtonBackground">#D8C6A2</SolidColorBrush> <!-- Medium warm tan -->
                    <SolidColorBrush x:Key="ButtonBorder">#B8A070</SolidColorBrush>     <!-- Tan border -->
                    <SolidColorBrush x:Key="ButtonHover">#CCA480</SolidColorBrush>      <!-- Soft warm hover -->
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Card Style -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F3B2F2A"/>
        </Style>
        <Style Selector="Border.Card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BoxShadow" Value="0 4 8 -2 #1E3B2F2A"/>
        </Style>

        <!-- Status Badge Style -->
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ── Action Button: distinct background in both themes ─────────── -->
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonHover}"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentAction}"/>
        </Style>
    </Application.Styles>
</Application>