<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <Var name="InPath" value=".\Publish\Windows" />
  <Var name="OutPath" value=".\Obfuscated" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="false" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="false" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="HideStrings" value="true" />
  <Var name="Optimize" value="true" />
  <Var name="SuppressStatistics" value="true" />

  <!-- String Hiding is active for both modules (Safest High-Security Mode) -->
  <Module file="$(InPath)\Syncr.UI.dll" />
  <Module file="$(InPath)\Syncr.Core.dll" />
</Obfuscator>
